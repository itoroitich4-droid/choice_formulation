# Supabase > Project Settings > Database > Connection string (use the "Transaction pooler" URI in production).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# https://PROJECT.supabase.co  (tokens are verified with the project's published signing keys)
SUPABASE_URL=https://PROJECT.supabase.co
# Only if your project still uses the legacy shared JWT secret (Settings > API > JWT secret). Otherwise leave empty.
SUPABASE_JWT_SECRET=
# Browser origins allowed to call the API, comma separated (the address where the web app is hosted).
CORS_ORIGINS=https://feed.yourcompany.example
