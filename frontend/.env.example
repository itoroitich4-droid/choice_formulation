# Supabase project (Settings > API). Use the publishable / anon key only - never the service-role key.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
# Base URL of the FastAPI service. Leave empty in development (Vite proxies /api to localhost:8000).
VITE_API_URL=
